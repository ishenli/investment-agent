{
  "name": "investment-agent",
  "version": "0.15.2",
  "description": "AI-powered investment management agent with real-time market analysis",
  "main": "dist-electron/main.js",
  "bin": {
    "investment-agent": "./bin/investment-agent.js",
    "ig": "./bin/ig.js"
  },
  "scripts": {
    "electron:dev": "concurrently -k \"next dev --port 8888\" \"wait-on http://localhost:8888 && electron .\"",
    "electron:build": "cross-env BUILD_TARGET=electron next build && node scripts/build-electron.mjs",
    "electron:pack": "npm run electron:build && electron-builder --config electron-builder.yml",
    "electron:pack:mac": "electron-builder --mac --config electron-builder.yml",
    "electron:build:pack": "npm run electron:build && npm run electron:pack:mac",
    "langgraph:dev": "langgraphjs dev --ui --port 54367 --no-browser",
    "langgraph:start": "langgraphjs up",
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "build:npm": "npm run build",
    "prepublishOnly": "npm run build:npm",
    "types:check": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss,less}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,scss,less}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "INVESTMENT_AGENT_DATA_DIR=./ drizzle-kit migrate",
    "db:push": "INVESTMENT_AGENT_DATA_DIR=./ tsx scripts/db-push.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "i18n:sync": "tsx scripts/sync-i18n.ts",
    "eval": "pnpm --filter @investment-agent/evaluation eval",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "release": "tsx scripts/release.ts"
  },
  "keywords": [
    "investment",
    "ai",
    "trading",
    "langchain"
  ],
  "author": "ishenli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishenli/investment-agent"
  },
