{
  "name": "@investment-agent/evaluation",
  "version": "0.1.0",
  "description": "Agent evaluation framework for investment-agent",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "investment-agent-eval": "./src/cli/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts"
    }
  },
  "scripts": {
    "eval": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "^1.34.0",
    "@mastra/evals": "^1.2.2"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
