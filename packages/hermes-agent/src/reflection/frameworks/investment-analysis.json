      "keywords": ["情绪", "恐慌", "贪婪", "资金流向", "北向资金", "主力", "散户", "舆论", "热搜", "关注度", "Put/Call", "VIX", "sentiment", "fear", "greed", "flow", "retail", "institutional", "social", "attention"]
