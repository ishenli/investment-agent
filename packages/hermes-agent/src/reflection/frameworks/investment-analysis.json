      "keywords": ["估值", "DCF", "DDM", "PEG", "目标价", "内在价值", "合理价格", "高估", "低估", "安全边际", "情景分析", "discount", "intrinsic value", "fair value", "overvalued", "undervalued", "margin of safety", "scenario"]
