      "keywords": ["风险", "波动", "回撤", "最大回撤", "夏普比率", "Beta", "相关性", "VaR", "Sortino", "黑天鹅", "流动性", "集中度", "止损", "对冲", "risk", "volatility", "drawdown", "Sharpe", "Beta", "correlation", "VaR", "Sortino", "black swan", "liquidity", "concentration", "hedge"]
